{
  "name": "a11-wild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/api",
    "infra",
    "web"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "npm run build -w web",
    "synth": "npm run synth -w infra",
    "check:public": "node scripts/check-public-repo.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run synth && npm run check:public",
    "probe": "node scripts/probe.mjs",
    "user:invite": "node scripts/invite-user.mjs",
    "references:load": "node scripts/load-references.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1175.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
